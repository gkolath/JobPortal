# Database (Railway provides Postgres automatically)
DATABASE_URL=postgresql://user:pass@host:5432/jobportal

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Adzuna (https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# JSearch via RapidAPI (optional fallback)
RAPIDAPI_KEY=

# Defaults
DEFAULT_LOCATION=Bangalore
MAX_USERS=2

# Seed on first deploy (set to 1 once, then remove)
RUN_SEED=0
