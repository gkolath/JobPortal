# Database (Render Postgres sets DATABASE_URL automatically via render.yaml)
DATABASE_URL=postgresql://user:pass@host:5432/jobportal

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Adzuna (https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# JSearch via RapidAPI (optional fallback)
RAPIDAPI_KEY=

# Apify LinkedIn + Indeed (recommended for more / fresher listings)
# Create token: https://console.apify.com/settings/integrations
APIFY_TOKEN=
APIFY_ENABLED=true
APIFY_JOB_ACTOR=harvestapi/linkedin-job-search
APIFY_MAX_ITEMS=25
APIFY_POSTED_LIMIT=Past Month
APIFY_TIMEOUT_SECS=300
APIFY_INDEED_ENABLED=true
APIFY_INDEED_ACTOR=misceres/indeed-scraper
APIFY_INDEED_MAX_ITEMS=25
APIFY_INDEED_MAX_CITIES=5

# Free public boards (no API key required)
REMOTIVE_ENABLED=true
ARBEITNOW_ENABLED=true
ARBEITNOW_MAX_PAGES=3

# Optional OpenAI for better resume parsing, AI match scoring, cover letters, gaps
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Max jobs to LLM-score per user on each refresh (~1 call each)
OPENAI_MAX_SCORE_JOBS=40
OPENAI_SCORE_CONCURRENCY=5

# Hide jobs below this score when matching
MIN_JOB_SCORE=40

# Defaults
DEFAULT_LOCATION=Bangalore
MAX_USERS=3

# Seed on first deploy (set to 1 once on Render, then remove)
RUN_SEED=0
