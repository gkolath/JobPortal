# Database (Render Postgres sets DATABASE_URL automatically via render.yaml)
DATABASE_URL=postgresql://user:pass@host:5432/jobportal

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Adzuna (https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# JSearch via RapidAPI (optional fallback)
RAPIDAPI_KEY=

# Apify LinkedIn jobs (recommended for more / fresher listings)
# Create token: https://console.apify.com/settings/integrations
APIFY_TOKEN=
APIFY_ENABLED=true
APIFY_JOB_ACTOR=harvestapi/linkedin-job-search
# Max jobs per title×location (~$0.001 each). 25 × 3 titles × 5 cities ≈ up to ~$0.40/refresh
APIFY_MAX_ITEMS=25
APIFY_POSTED_LIMIT=Past Month
APIFY_TIMEOUT_SECS=300

# Optional OpenAI for better resume parsing + relevance (recommended)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Hide jobs below this score when matching
MIN_JOB_SCORE=40

# Defaults
DEFAULT_LOCATION=Bangalore
MAX_USERS=3

# Seed on first deploy (set to 1 once on Render, then remove)
RUN_SEED=0
